<ui:FluentWindow x:Class="JRemote.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:JRemote.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="app.png"
        Height="780" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsAlwaysOnTop}">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Auto-Update Notification Banner -->
            <Border Grid.Row="0" Margin="0,0,0,12"
                    Background="#162235" BorderBrush="#00d2ff" BorderThickness="1.5" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="26" Foreground="#00d2ff" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- Content & Progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Normal Notification State -->
                        <StackPanel Visibility="{Binding IsNotDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Đã có phiên bản mới " FontWeight="Bold" FontSize="13" Foreground="#ffffff" />
                                <Border Background="#004b75" CornerRadius="4" Padding="6,1" Margin="4,0,6,0">
                                    <TextBlock Text="{Binding UpdateVersionTag}" FontWeight="Bold" FontSize="12" Foreground="#00d2ff" />
                                </Border>
                                <TextBlock Text="! Bạn có muốn cập nhật ngay bây giờ không?" FontSize="13" Foreground="#cccccc" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateNotes}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Downloading Progress State -->
                        <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Đang tải gói cập nhật từ GitHub..." FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" />
                                <TextBlock Text="{Binding DownloadProgressText}" FontSize="11" Foreground="#00d2ff" HorizontalAlignment="Right" />
                            </Grid>
                            <Border CornerRadius="3" ClipToBounds="True">
                                <ProgressBar Value="{Binding DownloadProgressPercent}" Minimum="0" Maximum="100" Height="6" Foreground="#00d2ff" Background="#0b131e" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsNotDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                        <ui:Button Appearance="Primary" Margin="0,0,8,0" Padding="14,6"
                                   Command="{Binding ApplyUpdateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload20" Margin="0,0,6,0" />
                                <TextBlock Text="Cập nhật ngay" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Padding="10,6"
                                   Command="{Binding DismissUpdateBannerCommand}" ToolTip="Bỏ qua lúc này">
                            <ui:SymbolIcon Symbol="Dismiss20" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Columns: Left Sidebar & Right Viewer -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Device Management & Controls -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- AirPlay Server Status Card -->
                <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Tv24" FontSize="18" Margin="0,0,8,0" Foreground="#38ef7d" />
                                <TextBlock Text="AirPlay Receiver (iPhone / iPad)" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Padding="8,4"
                                       Appearance="Secondary"
                                       Command="{Binding ToggleAirPlayCommand}">
                                <TextBlock Text="Bật / Tắt" />
                            </ui:Button>
                        </Grid>
                        <TextBlock Text="{Binding AirPlayStatus}" FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Background="#1a2530" CornerRadius="4" Padding="8,6">
                            <TextBlock Text="💡 Trên iPhone: Mở Control Center ➔ Chọn 'Phản chiếu màn hình' ➔ Chọn 'JRemote-PC'"
                                       FontSize="11" Foreground="#61afef" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Android Connection Card -->
                <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Phone24" FontSize="18" Margin="0,0,8,0" Foreground="#00c6ff" />
                            <TextBlock Text="Kết Nối Android (Wi-Fi / USB)" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <TextBlock Text="{Binding AdbStatus}" FontSize="12" Foreground="#888888" Margin="0,0,0,8" />
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        PlaceholderText="Nhập IP (VD: 192.168.1.50:5555)"
                                        Text="{Binding WifiIpInput, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" 
                                       Appearance="Primary"
                                       Content="Kết nối Wi-Fi" 
                                       Command="{Binding ConnectWifiCommand}" />
                        </Grid>
                        <TextBlock Text="Cắm cáp USB (đã bật USB Debugging) thiết bị sẽ tự động xuất hiện bên dưới."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!-- Devices List Card -->
                <ui:Card Grid.Row="2" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Danh Sách Thiết Bị" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <ui:Button HorizontalAlignment="Right" 
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Content="Làm mới"
                                       Command="{Binding RefreshDevicesCommand}" />
                        </Grid>

                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#202226" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Background="#2a3545" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="10" Foreground="#00c6ff" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#2a4535" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding ConnectionBadge}" FontSize="10" Foreground="#38ef7d" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Actions -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:Button Appearance="Secondary" 
                                                           FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                                           Content="Mở Wi-Fi"
                                                           Visibility="{Binding IsAndroid, Converter={x:Null}}"
                                                           Command="{Binding DataContext.EnableDeviceWifiAdbCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                           CommandParameter="{Binding}" />

                                                <ui:Button Appearance="Primary" 
                                                           FontSize="11" Padding="10,4"
                                                           Content="Phản Chiếu"
                                                           Command="{Binding DataContext.StartMirroringCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Splitter Separator -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Area: Mirroring Viewport & Floating Toolbar / Live Logs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top View Switcher Toolbar -->
                <Border Grid.Row="0" Background="#16181e" CornerRadius="8" Padding="6,5" Margin="0,0,0,8" BorderBrush="#262932" BorderThickness="1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Nút chuyển Tab Logs -->
                            <ui:Button Appearance="Secondary"
                                       Icon="{ui:SymbolIcon TextBulletList24}"
                                       Content="Nhật Ký Kết Nối (Logs)"
                                       Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding SelectLogsViewCommand}" />

                            <!-- Nút chuyển Tab Màn hình phản chiếu -->
                            <ui:Button Appearance="Primary"
                                       Icon="{ui:SymbolIcon Phone24}"
                                       Content="Màn Hình Phản Chiếu"
                                       Padding="10,5"
                                       IsEnabled="{Binding IsMirroringActive}"
                                       Command="{Binding SelectMirroringViewCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveSlots.Count, StringFormat='Đang chiếu: {0}/3 thiết bị'}" 
                                       Foreground="#38ef7d" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsMirroringActive, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Appearance="Secondary" FontSize="11" Padding="8,3"
                                       Content="Sao chép Log"
                                       Command="{Binding CopyLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Container cho Body: Log Console hoặc Mirroring Viewport -->
                <Grid Grid.Row="1">
                    <!-- Live Log Console: Hiển thị khi ShowLogsTab == True -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowLogsTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Guidance Banner -->
                        <Border Grid.Row="0" Background="#181a1f" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#252830" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ScreenSearch24" FontSize="24" Foreground="#38ef7d" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Đang chờ kết nối từ iPhone / Android..." FontSize="14" FontWeight="SemiBold" Foreground="#ffffff" />
                                    <TextBlock Text="Mở Control Center trên iPhone ➔ Chọn 'Phản chiếu màn hình' ➔ Nhấn 'JRemote-PC'. Nhật ký kết nối sẽ hiển thị bên dưới:"
                                               FontSize="12" Foreground="#888888" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Log Box -->
                        <Border Grid.Row="1" Background="#0e1014" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="TextBulletList24" FontSize="16" Foreground="#61afef" Margin="0,0,6,0" />
                                        <TextBlock Text="Nhật Ký Kết Nối Thời Gian Thực (Live Logs)" FontWeight="SemiBold" FontSize="13" Foreground="#abb2bf" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Appearance="Secondary" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                                   Content="Sao chép"
                                                   Command="{Binding CopyLogsCommand}" />
                                        <ui:Button Appearance="Secondary" FontSize="11" Padding="8,3"
                                                   Content="Xóa"
                                                   Command="{Binding ClearLogsCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ListBox Grid.Row="1"
                                         x:Name="LogsListBox"
                                         ItemsSource="{Binding LogEntries}"
                                         Background="#0b0d10"
                                         BorderBrush="#1a1c22"
                                         BorderThickness="1"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="11"
                                         Foreground="#98c379">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Active Mirroring Viewport: Hiển thị khi ShowLogsTab == False -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowLogsTab}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Global Control Toolbar -->
                        <Border Grid.Row="0" Background="#20222a" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" BorderBrush="#30343f" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Đang phản chiếu: " Foreground="#888888" FontSize="12" />
                                    <TextBlock Text="{Binding ActiveSlots.Count, StringFormat='{}{0}/3 Thiết bị'}" FontWeight="Bold" FontSize="12" Foreground="#38ef7d" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Pin24}" ToolTip="Ghim luôn ở trên cùng" Margin="0,0,8,0" Command="{Binding ToggleAlwaysOnTopCommand}" />
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon TextBulletList24}" ToolTip="Xem nhật ký kết nối" Margin="0,0,8,0" Command="{Binding SelectLogsViewCommand}" />
                                    <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}" Content="Đóng tất cả" ToolTip="Dừng tất cả phản chiếu" Command="{Binding StopMirroringCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Multi-Slot Grid Viewport: 1-3 Cột song song -->
                        <Grid Grid.Row="1">
                            <!-- Hiển thị khi chưa có slot nào hoạt động -->
                            <Border Background="#101216" CornerRadius="8" BorderBrush="#20232a" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMirroringActive}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Tv24" FontSize="44" Foreground="#444855" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="Chưa có thiết bị nào đang phản chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bật AirPlay trên iPhone hoặc cắm cáp Android để phản chiếu (Tối đa 3 thiết bị cùng lúc)" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- ItemsControl hiển thị 1 đến 3 Slots song song cạnh nhau -->
                            <ItemsControl ItemsSource="{Binding ActiveSlots}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMirroringActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,0" Background="#15171d" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Slot Header: Tên thiết bị, Slot index, Độ phân giải, FPS, Nút đóng ô -->
                                                <Border Grid.Row="0" Background="#1c1f26" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#282c37" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding SlotNumber, StringFormat='Slot {0}'}" FontSize="10" FontWeight="Bold" Foreground="#61afef" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DeviceItem.Name}" FontWeight="SemiBold" FontSize="12" Foreground="#ffffff" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding DeviceItem.Name}" />
                                                            <TextBlock Text="{Binding ResolutionText}" FontSize="10" Foreground="#888888" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FpsText}" FontSize="10" FontWeight="SemiBold" Foreground="#38ef7d" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <ui:Button Grid.Column="1" Appearance="Secondary"
                                                                   Icon="{ui:SymbolIcon Dismiss24}" FontSize="11" Padding="4,2" ToolTip="Đóng slot này"
                                                                   Command="{Binding RequestCloseCommand}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Mirror Screen Canvas -->
                                                <Border Grid.Row="1" Background="#000000" CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding ScreenBitmap}"
                                                           Tag="{Binding}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           SnapsToDevicePixels="True"
                                                           UseLayoutRounding="True"
                                                           MouseDown="OnSlotMouseDown"
                                                           MouseMove="OnSlotMouseMove"
                                                           MouseUp="OnSlotMouseUp"
                                                           MouseRightButtonUp="OnSlotMouseRightButtonUp"
                                                           MouseWheel="OnSlotMouseWheel" />
                                                </Border>

                                                <!-- Slot Bottom Controls Toolbar: Back, Home, Recent, Screenshot -->
                                                <Border Grid.Row="2" Background="#1c1f26" CornerRadius="6" Padding="6,4" Margin="0,6,0,0">
                                                    <UniformGrid Rows="1" HorizontalAlignment="Center">
                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Quay lại (Back)" Margin="2,0" Padding="8,4" Command="{Binding SendBackCommand}" />
                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Circle24}" ToolTip="Màn hình chính (Home)" Margin="2,0" Padding="8,4" Command="{Binding SendHomeCommand}" />
                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Square24}" ToolTip="Đa nhiệm (Recent Apps)" Margin="2,0" Padding="8,4" Command="{Binding SendRecentAppsCommand}" />
                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Camera24}" ToolTip="Chụp ảnh màn hình" Margin="2,0" Padding="8,4" Command="{Binding TakeScreenshotCommand}" />
                                                    </UniformGrid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        <!-- Status Bar Footer -->
        <StatusBar Grid.Row="2" Background="#14161a" BorderBrush="#252830" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Update Available Button Pill -->
                    <ui:Button Appearance="Primary" Padding="8,3" Margin="0,0,8,0"
                               Command="{Binding ShowUpdateBannerCommand}"
                               ToolTip="Nhấn để xem thông tin bản cập nhật mới"
                               Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="13" Margin="0,0,5,0" Foreground="#ffffff" />
                            <TextBlock Text="{Binding UpdateVersionTag, StringFormat='Bản mới: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#ffffff" />
                        </StackPanel>
                    </ui:Button>

                    <Border Background="#1b212c" BorderBrush="#204060" BorderThickness="1" CornerRadius="4" Padding="8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Tag20" FontSize="12" Foreground="#00c6ff" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="#00c6ff" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
